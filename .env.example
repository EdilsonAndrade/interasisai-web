# Copy this file to .env and fill in the values.

# ============================================================================
# Backend Python de Agendamento IA (primary chat endpoint)
# ============================================================================
# URL base do backend Python (FastAPI). Em desenvolvimento: http://localhost:8000
NEXT_PUBLIC_PYTHON_BACKEND_URL=http://localhost:8000
# Tenant ID para multi-tenancy. Identificador do cliente/empresa.
NEXT_PUBLIC_TENANT_ID=987654

# URL canônica pública usada por metadata/Open Graph.
# Também usada como base do snippet de instalação do widget embutível
# (https://{NEXT_PUBLIC_SITE_URL}/widget/{tenantId}) — ver specs/016-embeddable-chat-widget.
NEXT_PUBLIC_SITE_URL=https://interasisai.com.br

# ============================================================================
# Backend BFF NestJS (legacy — mantido para compatibilidade)
# ============================================================================
NEXT_PUBLIC_CHAT_BFF_ENDPOINT=http://localhost:3001/chat/message

# ============================================================================
# Feature Flags
# ============================================================================
# Habilita gravação e envio de áudio pelo microfone no chat.
# Default: false (áudio desabilitado na v1 — será reativado quando backend Python suportar)
NEXT_PUBLIC_ENABLE_AUDIO=false

# ============================================================================
# Painel Administrador
# ============================================================================
# Credenciais server-only de acesso ao /admin. Nunca use NEXT_PUBLIC_ aqui.
ADM_USER=your-admin-user
ADM_PWD=your-admin-password
# Gere um valor aleatório forte, por exemplo: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-high-entropy-random-secret
